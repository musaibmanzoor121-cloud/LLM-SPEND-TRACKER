rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation blueprints
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256;
    }

    function isValidChat(data, userId) {
      return data.userId == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.model is string && data.model.size() <= 64;
    }

    function isValidMessage(data, userId) {
      return data.userId == userId
        && (data.role == 'user' || data.role == 'model' || data.role == 'system')
        && data.content is string && data.content.size() <= 50000;
    }

    function isValidSettings(data, userId) {
      return data.userId == userId;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other user profiles
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // User Chat Sessions
      match /chats/{chatId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChat(incoming(), userId);
        allow update: if isOwner(userId) && isValidChat(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);

        // Chat Messages Subcollection
        match /messages/{messageId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidMessage(incoming(), userId);
          allow update: if isOwner(userId) && isValidMessage(incoming(), userId) && incoming().userId == existing().userId;
          allow delete: if isOwner(userId);
        }
      }

      // User Settings and Preferences
      match /settings/{settingId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSettings(incoming(), userId);
        allow update: if isOwner(userId) && isValidSettings(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
